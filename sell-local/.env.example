# Copy to .env and adjust. All have sensible defaults; nothing here is a secret in M0/M1.
# (M2/M3 will add ANTHROPIC_API_KEY and ADMIN_PASSWORD — keep those out of git.)

# Path to the SQLite file (default: sell_local.db in project root).
# SELL_LOCAL_DB=/absolute/path/to/sell_local.db

# Contact rendering gate: 'public' (default, Phase 1) | 'gated'
CONTACT_MODE=public

# Listing defaults
DEFAULT_EXPIRY_DAYS=30
PAGE_SIZE=24

# UI display timezone (DB stores UTC)
DISPLAY_TZ=Asia/Dubai
