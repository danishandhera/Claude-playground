# helthi secrets -- copy to `.env` and fill in. NEVER commit the real .env.
# Register a Whoop app at https://developer.whoop.com and create OAuth creds.

# OAuth2 client credentials from the Whoop Developer Dashboard.
WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here

# Redirect URI. MUST exactly match one registered on your Whoop app.
# helthi's `auth` command runs a local callback server on this URI.
WHOOP_REDIRECT_URI=http://localhost:8080/callback

# Where the rotated OAuth token JSON is persisted (access + refresh token).
# Auto-refreshed on each API call via the on_token_refresh callback.
# Defaults to ~/.config/helthi/whoop_token.json if unset.
# WHOOP_TOKEN_PATH=~/.config/helthi/whoop_token.json
